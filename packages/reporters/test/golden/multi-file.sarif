          "rules": [
            {
              "fullDescription": {
                "text": "An operation in the baseline has no counterpart in the candidate. Removing an operation is the most direct way to break existing consumers."
              },
              "helpUri": "https://github.com/zainkhan-bit/ContractGuard/blob/main/docs/rules/CG-API-001.md",
              "id": "CG-API-001",
              "name": "OperationRemoved",
              "properties": {
                "tags": [
                  "contractguard",
                  "api"
                ]
              },
              "shortDescription": {
                "text": "Operation removed"
              }
            },
            {
              "fullDescription": {
                "text": "The candidate adds a new operation. Additions widen what the provider accepts."
              },
              "helpUri": "https://github.com/zainkhan-bit/ContractGuard/blob/main/docs/rules/CG-API-002.md",
              "id": "CG-API-002",
              "name": "OperationAdded",
              "properties": {
                "tags": [
                  "contractguard",
                  "api"
                ]
              },
              "shortDescription": {
                "text": "Operation added"
              }
            },
            {
              "fullDescription": {
                "text": "A removed operation matches an added one by operationId or a case/trailing-slash difference. A moved operation is a removal for existing consumers even when the functionality survives."
              },
              "helpUri": "https://github.com/zainkhan-bit/ContractGuard/blob/main/docs/rules/CG-API-003.md",
              "id": "CG-API-003",
              "name": "OperationPathChangedProbableRename",
              "properties": {
                "tags": [
                  "contractguard",
                  "api"
                ]
              },
              "shortDescription": {
                "text": "Operation path changed (probable rename)"
              }
            },
            {
              "fullDescription": {
                "text": "The deprecated flag of an operation was toggled. Deprecation is metadata; it is reported for visibility."
              },
              "helpUri": "https://github.com/zainkhan-bit/ContractGuard/blob/main/docs/rules/CG-API-004.md",
              "id": "CG-API-004",
              "name": "OperationDeprecationChanged",
              "properties": {
                "tags": [
                  "contractguard",
                  "api"
                ]
              },
              "shortDescription": {
                "text": "Operation deprecation changed"
              }
            },
            {
              "fullDescription": {
                "text": "A path template variable changed name at the same position. Template names are not sent on the wire."
              },
              "helpUri": "https://github.com/zainkhan-bit/ContractGuard/blob/main/docs/rules/CG-API-005.md",
              "id": "CG-API-005",
              "name": "PathParameterRenamed",
              "properties": {
                "tags": [
                  "contractguard",
                  "api"
                ]
              },
              "shortDescription": {
                "text": "Path parameter renamed"
              }
            },
            {
              "fullDescription": {
                "text": "The same operation has a different operationId. operationId is a code-generation identity, not a wire identity."
              },
              "helpUri": "https://github.com/zainkhan-bit/ContractGuard/blob/main/docs/rules/CG-API-006.md",
              "id": "CG-API-006",
              "name": "operationIdChanged",
              "properties": {
