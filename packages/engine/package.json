{
  "name": "@zainkhan-bit/contractguard-engine",
  "version": "1.0.1",
  "description": "ContractGuard engine: protocol-independent semantic diff of canonical API contracts and compatibility evaluation.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zainkhan-bit/ContractGuard.git",
    "directory": "packages/engine"
  },
  "keywords": [
    "openapi",
    "api",
    "breaking-changes",
    "compatibility",
    "diff"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@zainkhan-bit/contractguard-core": "workspace:*"
  },
  "devDependencies": {
    "@zainkhan-bit/contractguard-openapi": "workspace:*"
  }
}
