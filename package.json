{
  "name": "contractguard-monorepo",
  "private": true,
  "description": "ContractGuard — deterministic API contract compatibility analysis (monorepo root)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.12",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p packages/core/test && tsc -p packages/openapi/test && tsc -p packages/engine/test && tsc -p packages/reporters/test && tsc -p packages/app/test && tsc -p packages/cli/test",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check . && pnpm run deps:check",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "deps:check": "depcruise packages --config .dependency-cruiser.cjs",
    "smoke:pack": "node scripts/pack-smoke.mjs",
    "check": "pnpm run build && pnpm run lint && pnpm run coverage",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
